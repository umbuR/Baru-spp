{
  "entities": {
    "LoanApplication": {
      "title": "LoanApplication",
      "description": "Pengajuan pinjaman nasabah PM Mitra Sejahtera Bersama",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID unik pengajuan" },
        "nomorPerjanjian": { "type": "string", "description": "Nomor surat perjanjian resmi" },
        "namaLengkap": { "type": "string", "description": "Nama lengkap nasabah" },
        "nikKtp": { "type": "string", "description": "Nomor NIK KTP nasabah" },
        "nomorHp": { "type": "string", "description": "Nomor HP / WhatsApp nasabah" },
        "alamat": { "type": "string", "description": "Alamat tempat tinggal lengkap" },
        "pekerjaan": { "type": "string", "description": "Jenis pekerjaan" },
        "penghasilanBulanan": { "type": "number", "description": "Penghasilan per bulan" },
        "jumlahPinjaman": { "type": "number", "description": "Plafon pinjaman yang diajukan" },
        "tenorBulan": { "type": "number", "description": "Jangka waktu pinjaman dalam bulan" },
        "angsuranBulanan": { "type": "number", "description": "Besaran cicilan per bulan" },
        "bungaPersen": { "type": "number", "description": "Suku bunga per tahun" },
        "tujuanPinjaman": { "type": "string", "description": "Alasan penggunaan dana" },
        "status": { "type": "string", "description": "Status pengajuan (diajukan, disetujui, ditolak, dicairkan)" },
        "fotoKtp": { "type": "string", "description": "Foto KTP terverifikasi (Base64 atau URL)" },
        "fotoKk": { "type": "string", "description": "Foto Kartu Keluarga terverifikasi" },
        "fotoSelfie": { "type": "string", "description": "Foto Selfie Liveness nasabah" },
        "tandaTanganNasabah": { "type": "string", "description": "Tanda tangan digital e-Signature nasabah" },
        "biometrikTerverifikasi": { "type": "boolean", "description": "Status WebAuthn FaceID/Fingerprint" },
        "createdAt": { "type": "string", "description": "Waktu pengajuan dibuat (ISO string)" },
        "updatedAt": { "type": "string", "description": "Waktu pengajuan terakhir diperbarui" }
      },
      "required": ["id", "namaLengkap", "nikKtp", "jumlahPinjaman", "tenorBulan", "status", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Log aktivitas verifikasi dan persetujuan pengajuan",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID log" },
        "applicationId": { "type": "string", "description": "ID pengajuan terkait" },
        "action": { "type": "string", "description": "Tindakan yang dilakukan" },
        "operator": { "type": "string", "description": "Nama atau peran operator" },
        "timestamp": { "type": "string", "description": "Waktu kejadian ISO string" },
        "notes": { "type": "string", "description": "Catatan aktivitas" }
      },
      "required": ["id", "action", "timestamp"]
    }
  },
  "firestore": {
    "/loan_applications/{applicationId}": {
      "schema": "LoanApplication",
      "description": "Koleksi data pengajuan pinjaman nasabah"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Koleksi jejak audit persetujuan dan verifikasi"
    }
  }
}
